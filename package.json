{
  "name": "keyboardshortcut-explorer",
  "displayName": "Keyboard Shortcuts",
  "description": "A fantastic extension to explore your keyboard shortcuts",
  "version": "1.0.3",
  "publisher": "GaetanoTaormina",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gaetano-Taormina/KeyboardShortcut_Explorer.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./assets/js/extension.js",
  "contributes": {
    "configuration": {
      "title": "KeyboardShortcut Explorer",
      "properties": {
        "keyboardshortcut-explorer.fontFamily": {
          "type": "string",
          "default": "var(--vscode-font-family)",
          "description": "General font family for the interface."
        },
        "keyboardshortcut-explorer.fontSize": {
          "type": "number",
          "default": 16,
          "description": "Base font size for the shortcuts list."
        },
        "keyboardshortcut-explorer.keysFontSize": {
          "type": "number",
          "default": 14,
          "description": "Font size for the shortcut keys."
        },
        "keyboardshortcut-explorer.titleFontSize": {
          "type": "number",
          "default": 16,
          "description": "Font size for the category titles."
        },
        "keyboardshortcut-explorer.colorProfile": {
          "type": "string",
          "enum": ["VS Code Native", "Alternative 1", "Alternative 2", "Custom"],
          "default": "VS Code Native",
          "description": "Choose a color profile to change where UI elements get their colors from. Switches to Custom if manual colors are edited."
        },
        "keyboardshortcut-explorer.appearanceMode": {
          "type": "string",
          "enum": ["Auto", "Dark", "Light", "High Contrast"],
          "default": "Auto",
          "description": "Force the overall appearance mode. This is independent of the color profile."
        },
        "keyboardshortcut-explorer.alternateRowColors": {
          "type": "boolean",
          "default": true,
          "description": "Enable alternating row colors (zebra striping) for shortcut items."
        },
        "keyboardshortcut-explorer.alternateRowColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#82828210",
          "description": "Color for the alternating rows when enabled."
        },
        "keyboardshortcut-explorer.textColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#cccccc",
          "description": "General text color."
        },
        "keyboardshortcut-explorer.titleBackgroundColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#323232",
          "description": "Background color for the category titles."
        },
        "keyboardshortcut-explorer.keysBackgroundColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#2b2b2b",
          "description": "Background color for the shortcut keys box."
        },
        "keyboardshortcut-explorer.bubbleColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#252526",
          "description": "Color for the chat bubble background."
        },
        "keyboardshortcut-explorer.scrollbarColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#79797966",
          "description": "Color of the vertical scrollbar thumb."
        },
        "keyboardshortcut-explorer.accessibilityMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable Dyslexia Mode."
        },
        "keyboardshortcut-explorer.dyslexiaFont": {
          "type": "string",
          "default": "'Comic Sans MS', 'OpenDyslexic', 'Trebuchet MS', sans-serif",
          "description": "Font family used when Dyslexia Mode is enabled."
        },
        "keyboardshortcut-explorer.dyslexiaBold": {
          "type": "boolean",
          "default": false,
          "description": "Force bold text in Dyslexia Mode."
        },
        "keyboardshortcut-explorer.dyslexiaLetterSpacing": {
          "type": "string",
          "default": "0.08em",
          "description": "Letter spacing when Dyslexia Mode is enabled."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "keyboardShortcutsView",
          "name": "Keyboard Shortcuts",
          "icon": "assets/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "keyboardshortcut-explorer.filter",
        "title": "Toggle Reorder Mode",
        "icon": "$(filter)"
      },
      {
        "command": "keyboardshortcut-explorer.toggleSearch",
        "title": "Toggle Search Bar"
      },
      {
        "command": "keyboardshortcut-explorer.toggleExtensions",
        "title": "Customize View..."
      },
      {
        "command": "keyboardshortcut-explorer.openKeybindings",
        "title": "Open Keyboard Shortcuts Table",
        "icon": "$(keyboard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "keyboardshortcut-explorer.filter",
          "when": "view == keyboardShortcutsView",
          "group": "navigation@3"
        },
        {
          "command": "keyboardshortcut-explorer.openKeybindings",
          "when": "view == keyboardShortcutsView",
          "group": "navigation@2"
        },
        {
          "command": "keyboardshortcut-explorer.toggleSearch",
          "when": "view == keyboardShortcutsView",
          "group": "1_more@1"
        },
        {
          "command": "keyboardshortcut-explorer.toggleExtensions",
          "when": "view == keyboardShortcutsView",
          "group": "1_more@2"
        }
      ]
    }
  },
  "activationEvents": []
}
