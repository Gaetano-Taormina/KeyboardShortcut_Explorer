{
  "name": "keyboardshortcut-explorer",
  "displayName": "Keyboard Shortcuts",
  "description": "A fantastic extension to explore your keyboard shortcuts",
  "version": "1.0.8",
  "publisher": "GaetanoTaormina",
  "icon": "src/assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gaetano-Taormina/KeyboardShortcut_Explorer.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./backend/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "vite build",
    "watch": "vite build --watch",
    "package:local": "node scripts/package-local.js",
    "publish:local": "node scripts/publish-local.js",
    "dev": "vite",
    "lint": "oxlint"
  },
  "contributes": {
    "configuration": {
      "title": "KeyboardShortcut Explorer",
      "properties": {
        "keyboardshortcut-explorer.colors.appearanceMode": {
          "type": "string",
          "enum": [
            "Native",
            "Dark",
            "Light",
            "High Contrast"
          ],
          "default": "Native",
          "description": "Force the overall appearance mode. 'Native' uses the current VS Code theme."
        },
        "keyboardshortcut-explorer.appearance.alternateRowColors": {
          "type": "boolean",
          "default": true,
          "description": "Enable alternating row colors (zebra striping) for shortcut items."
        },
        "keyboardshortcut-explorer.colors.colorProfile": {
          "type": "string",
          "enum": [
            "VS Code Native",
            "Alternative 1",
            "Alternative 2",
            "Custom"
          ],
          "default": "VS Code Native",
          "description": "Choose a color profile. Switches to Custom if manual colors are edited."
        },
        "keyboardshortcut-explorer.colors.textColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#09090B",
          "description": "General text color."
        },
        "keyboardshortcut-explorer.colors.titleBackgroundColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#0C0E0C",
          "description": "Background color for the category titles."
        },
        "keyboardshortcut-explorer.colors.keysBackgroundColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#050505",
          "description": "Background color for the shortcut keys box."
        },
        "keyboardshortcut-explorer.colors.bubbleColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#080708",
          "description": "Color for the chat bubble background."
        },
        "keyboardshortcut-explorer.colors.searchbarBackgroundColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#4F6287",
          "description": "Background color for the search bar."
        },
        "keyboardshortcut-explorer.colors.searchbarTextColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#0A0A0B",
          "description": "Text color for the search bar."
        },
        "keyboardshortcut-explorer.colors.scrollbarColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#79797966",
          "description": "Color of the vertical scrollbar thumb. Supports opacity via 8-digit hex."
        },
        "keyboardshortcut-explorer.colors.alternateRowColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#405444",
          "description": "Color for the alternating rows when enabled."
        },
        "keyboardshortcut-explorer.typography.fontFamily": {
          "type": "string",
          "default": "var(--vscode-font-family)",
          "description": "General font family for the interface."
        },
        "keyboardshortcut-explorer.typography.fontSize": {
          "type": "number",
          "default": 13,
          "description": "Base font size for the shortcuts list (command names)."
        },
        "keyboardshortcut-explorer.typography.titleFontSize": {
          "type": "number",
          "default": 15,
          "description": "Font size for the category titles."
        },
        "keyboardshortcut-explorer.typography.keysFontSize": {
          "type": "number",
          "default": 11,
          "description": "Font size for the shortcut keys."
        },
        "keyboardshortcut-explorer.accessibility.accessibilityMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable Dyslexia Mode."
        },
        "keyboardshortcut-explorer.accessibility.dyslexiaFont": {
          "type": "string",
          "default": "'Comic Sans MS', 'OpenDyslexic', 'Trebuchet MS', sans-serif",
          "description": "Font family used when Dyslexia Mode is enabled."
        },
        "keyboardshortcut-explorer.accessibility.dyslexiaBold": {
          "type": "boolean",
          "default": false,
          "description": "Force bold text in Dyslexia Mode."
        },
        "keyboardshortcut-explorer.accessibility.dyslexiaLetterSpacing": {
          "type": "string",
          "default": "0.08em",
          "description": "Letter spacing when Dyslexia Mode is enabled."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "keyboardShortcutsView",
          "name": "Keyboard Shortcuts",
          "icon": "assets/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "keyboardshortcut-explorer.toggleSearch",
        "title": "Toggle Search Bar",
        "icon": "$(search)"
      },
      {
        "command": "keyboardshortcut-explorer.toggleExtensions",
        "title": "Manage Extensions",
        "icon": "$(add)"
      },
      {
        "command": "keyboardshortcut-explorer.toggleReorderMode",
        "title": "Grid Reorder Mode",
        "icon": "$(table)"
      },
      {
        "command": "keyboardshortcut-explorer.openSettings",
        "title": "Settings Editor",
        "icon": "$(gear)"
      },
      {
        "command": "keyboardshortcut-explorer.openKeybindings",
        "title": "Open Keyboard Shortcuts Table",
        "icon": "$(keyboard)"
      },
      {
        "command": "keyboardshortcut-explorer.openColorPicker",
        "title": "Color Theme Editor"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "keyboardshortcut-explorer.toggleExtensions",
          "when": "view == keyboardShortcutsView",
          "group": "navigation@1"
        },
        {
          "command": "keyboardshortcut-explorer.toggleReorderMode",
          "when": "view == keyboardShortcutsView",
          "group": "navigation@2"
        },
        {
          "command": "keyboardshortcut-explorer.openKeybindings",
          "when": "view == keyboardShortcutsView",
          "group": "navigation@3"
        },
        {
          "command": "keyboardshortcut-explorer.openSettings",
          "when": "view == keyboardShortcutsView",
          "group": "1_more@2"
        },
        {
          "command": "keyboardshortcut-explorer.toggleSearch",
          "when": "view == keyboardShortcutsView",
          "group": "1_more@1"
        },
        {
          "command": "keyboardshortcut-explorer.openColorPicker",
          "when": "view == keyboardShortcutsView",
          "group": "1_more@3"
        }
      ]
    }
  },
  "activationEvents": [],
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "jimp": "^1.6.1",
    "oxlint": "^1.80.0",
    "sass": "^1.103.1",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
